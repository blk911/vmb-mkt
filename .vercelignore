# Keep serverless bundles under Vercel’s 250 MB unzipped limit — exclude heavy local datasets.
tools/
backend/data/
**/__pycache__/
**/*.pyc

# Bulk `data/` (DORA tables, derived, etc.) stays off the deployment — but `/admin/markets` reads
# JSON from `data/markets/` via `src/lib/markets.ts`, so we allow that folder’s catalog files only.
data/*
!data/markets/
data/markets/*
!data/markets/beauty_regions.json
!data/markets/beauty_zones.json
!data/markets/beauty_zone_members.json
!data/markets/beauty_zone_members_enriched.json
!data/markets/beauty_zone_members_enriched_with_presence.json
!data/markets/beauty_zone_members_enriched_with_presence_and_anchor.json
!data/markets/beauty_zone_members_enriched_full.json

# Social targets seed JSON (bundled imports in `src/lib/social-targets/*-store.ts`).
!data/socialTargets/
data/socialTargets/*
!data/socialTargets/social_targets_v1.json
!data/socialTargets/referral_edges_v1.json

# Runtime artifacts are mostly local-only; keep minimal operator-console artifacts in deployment.
runtime-data/*
!runtime-data/resolver_registry.v1.json
!runtime-data/resolver_summary.json
!runtime-data/operator_review_states.json
